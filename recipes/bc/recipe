name=bc
version=1.08.2
description="GNU bc: arbitrary precision calculator (bc and dc)"
depends=(glibc readline ncurses)
source=(https://ftp.gnu.org/gnu/bc/bc-$version.tar.gz)
sha256=(ae470fec429775653e042015edc928d07c8c3b2fc59765172a330d3d87785f86)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--with-readline MAKEINFO=true
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	rm -f "$pkgdir"/usr/lib/*.la
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/bc/COPYING"
}
