name=kmod
version=34.3
description="Tools to load and manage kernel modules (modprobe, depmod)"
depends=(glibc zstd)
# Signed by Lucas De Marchi (EAB33C9690013C733916AC839BA2A5A630CBEA53).
source=(https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-$version.tar.xz)
sha256=(985554de49c21a58abd68c6cda2251384e1e5bb08b3b14c7f02b51f4c90c2958)

build() {
	meson_build -Dzstd=enabled -Dxz=disabled -Dzlib=disabled -Dopenssl=disabled \
		-Dmanpages=false -Ddocs=false -Dbuild-tests=false \
		-Dbashcompletiondir=no -Dfishcompletiondir=no -Dzshcompletiondir=no
}

package() {
	meson_package
}
