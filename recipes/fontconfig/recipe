name=fontconfig
version=2.18.4
description="Font discovery and configuration"
depends=(glibc freetype expat)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://gitlab.freedesktop.org/api/v4/projects/fontconfig%2Ffontconfig/packages/generic/fontconfig/$version/fontconfig-$version.tar.xz)
sha256=(95013637eff5f81d4871dd16cd098c273264c16d0f9f0b27cc43b81b2794bee3)

build() {
	# The font cache cannot be built here (it needs the target's fc-cache);
	# it is created in /var/cache/fontconfig on first use.
	meson_build -Ddoc=disabled -Dnls=disabled -Dtests=disabled -Dtools=enabled \
		-Dcache-build=disabled -Dxml-backend=expat -Diconv=disabled
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/gettext" "$pkgdir/usr/share/locale" \
		"$pkgdir/var"
}
