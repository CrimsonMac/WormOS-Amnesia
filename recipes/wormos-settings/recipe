name=wormos-settings
version=0.1.0
release=5
description="Settings: display, appearance, keyboard, mouse, sound, time, privacy and the virtual machine"
depends=(glibc json-c gtk4 worm wlr-randr wireplumber hicolor-icon-theme)
# Builds src/settings, which also uses src/common.
localsrc=src

build() {
	make -C settings CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make -C settings DESTDIR="$pkgdir" install
}
