name=wormos-settings
version=0.1.0
release=2
description="Settings: display, appearance, keyboard, mouse, sound, time, privacy and the virtual machine"
depends=(glibc gtk4 worm wlr-randr wireplumber hicolor-icon-theme)
localsrc=src/settings

build() {
	make CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make DESTDIR="$pkgdir" install
}
