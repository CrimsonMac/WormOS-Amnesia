name=bh
version=0.2.0
release=3
description="Blackholes: disposable sandboxes for untrusted programs"
depends=(glibc passt kvmtool)
# Builds src/bh, which also uses sources from src/common.
localsrc=src

build() {
	make -C bh CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make -C bh DESTDIR="$pkgdir" install
}
