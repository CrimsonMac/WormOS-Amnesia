name=labwc
version=0.20.3
release=2
description="Stacking Wayland compositor (window manager)"
depends=(glibc wlroots libxml2 glib cairo pango libpng libinput libxcb xcb-util-wm xwayland)
# Upstream publishes no signature: checksum pinned from the release download.
source=(labwc-$version.tar.gz::https://github.com/labwc/labwc/archive/refs/tags/$version.tar.gz)
sha256=(1e70a5b74f149c5b47da76063dbdf967c44b2d7b6e94d3fdf65f70fc252f65c9)

build() {
	# LABWC_NO_XWAYLAND=1 leaves Xwayland out (the login screen).
	patch -p1 < "$recipedir/files/no-xwayland.patch"
	meson_build -Dxwayland=enabled -Dsvg=disabled -Dicon=disabled \
		-Dnls=disabled -Dman-pages=disabled -Dtest=disabled
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/wayland-sessions" \
		"$pkgdir/usr/share/xdg-desktop-portal"
}
