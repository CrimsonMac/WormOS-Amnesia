<?xml version="1.0"?>
<!-- The desktop menu (right click on the background). -->
<openbox_menu>
  <menu id="root-menu" label="WormOS">
    <item label="Files">
      <action name="Execute" command="wormos-files" />
    </item>
    <item label="Terminal">
      <action name="Execute" command="foot" />
    </item>
    <item label="Root terminal">
      <action name="Execute" command="foot --title 'Root terminal' /usr/lib/worm/root-terminal" />
    </item>
    <menu id="apps" label="Applications" execute="/usr/lib/worm/apps-menu" />
    <item label="Software">
      <action name="Execute" command="wormos-software" />
    </item>
    <separator />
    <menu id="snapshots" label="Snapshots">
      <item label="Open Snapshots">
        <action name="Execute" command="wormos-snapshots" />
      </item>
      <item label="Take a snapshot">
        <action name="Execute" command="/usr/lib/worm/quick-action snapshot" />
      </item>
      <item label="System status">
        <action name="Execute" command="foot --hold --title 'System status' worm status" />
      </item>
    </menu>
    <item label="Settings">
      <action name="Execute" command="wormos-settings" />
    </item>
    <item label="Change wallpaper">
      <action name="Execute" command="wormos-settings --page appearance" />
    </item>
    <item label="Screenshot">
      <action name="Execute" command="/usr/lib/worm/screenshot" />
    </item>
    <separator />
    <item label="Welcome and shortcuts">
      <action name="Execute" command="wormos-welcome" />
    </item>
    <item label="Reload settings">
      <action name="Reconfigure" />
    </item>
    <item label="Log out">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
