# Programs started with the desktop (labwc runs this with sh).
# Programs the message bus starts on demand need the display too.
dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP > /dev/null 2>&1
# The wallpaper the user chose (Settings > Appearance).
/usr/lib/worm/wallpaper
# The bridge of wormhole programs to the desktop (links, files, terminals
# and root requests from inside wormholes). Started here, it has the
# display to hand on; it exits with the compositor.
[ -x /usr/lib/wh/bridge ] && /usr/lib/wh/bridge 2>> "$XDG_RUNTIME_DIR/bridge.log" &
# The panel, the application launcher and notifications.
worm-shell > "$XDG_RUNTIME_DIR/shell.log" 2>&1 &
# The SPICE agent (QEMU, virt-manager): the clipboard shared with the
# VM's host, the pointer of SPICE clients and the display size following
# their window. It exits at once outside such a VM.
# Off with "worm vm set clipboard off".
if ! grep -qx 'clipboard=off' /run/worm/vm 2> /dev/null; then
	clip agent > "$XDG_RUNTIME_DIR/clip.log" 2>&1 &
fi
# The live system (the ISO) opens the installer.
if [ -e /run/wormos/live ] && [ -x /usr/bin/wormos-installer ]; then
	wormos-installer > /dev/null 2>&1 &
fi
# A welcome terminal the first time a user starts the desktop.
if [ ! -e "$HOME/.config/wormos/welcomed" ]; then
	mkdir -p "$HOME/.config/wormos" && touch "$HOME/.config/wormos/welcomed"
	foot --title "Welcome to WormOS" sh -c 'welcome --full; WORMOS_GREETED=1 exec "${SHELL:-/bin/sh}" -l' > /dev/null 2>&1 &
fi
