# The environment of a labwc session, for the desktop (session) and the
# login screen (greeter-session). Sourced; defines run_labwc.

export LANG=${LANG:-C.UTF-8}
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc:wlroots
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_DATA_DIRS=/usr/local/share:/usr/share
export LIBSEAT_BACKEND=seatd
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland GDK_BACKEND=wayland
export SDL_VIDEODRIVER=wayland ELECTRON_OZONE_PLATFORM_HINT=wayland
# Cursor and keyboard defaults (Caps Lock turns off as the key goes down,
# /etc/xkb/symbols/wormos). They are not in labwc's environment file:
# labwc reads only the first one it finds, so the user's, which holds the
# keyboard layout chosen at the first boot, would hide them.
export XCURSOR_THEME=${XCURSOR_THEME:-Adwaita} XCURSOR_SIZE=${XCURSOR_SIZE:-24}
export XKB_DEFAULT_OPTIONS=${XKB_DEFAULT_OPTIONS-wormos:caps_unlock_on_press}

# Editions with a look of their own (WormOS Amnesia, /etc/worm/variant):
# their desktop settings are found first, their GTK theme and panel edge.
if [ -r /etc/worm/variant ]; then
	VARIANT_XDG= VARIANT_GTK_THEME= VARIANT_PANEL=
	. /etc/worm/variant
	[ -n "$VARIANT_XDG" ] && export XDG_CONFIG_DIRS="$VARIANT_XDG:$XDG_CONFIG_DIRS"
	[ -n "$VARIANT_GTK_THEME" ] && export GTK_THEME=$VARIANT_GTK_THEME
	[ -n "$VARIANT_PANEL" ] && export WORM_SHELL_PANEL=$VARIANT_PANEL
fi

# Intel GPUs, VMware's (vmwgfx, Mesa svga, with 3D acceleration on) and
# QEMU's virtio GPU with 3D (virgl: virt-manager's OpenGL option; bit 0 of
# the virtio device's features) render with OpenGL ES; everything else uses
# the software renderer, which is faster than OpenGL emulated on the CPU.
# With VMware's 3D acceleration off, OpenGL ES fails at the start and
# run_labwc falls back to software.
if [ -z "${WLR_RENDERER:-}" ]; then
	renderer=pixman
	for driver in /sys/class/drm/card*/device/driver; do
		case $(basename "$(readlink "$driver")") in
		i915|xe|vmwgfx) renderer= ;;
		virtio-pci)
			# The GPU is the virtio device below the PCI one.
			for virtio in "${driver%/driver}"/virtio*; do
				[ "$(basename "$(readlink "$virtio/driver")")" = virtio_gpu ] || continue
				features=$(cat "$virtio/features" 2>/dev/null)
				[ "${features%"${features#?}"}" = 1 ] && renderer=
			done ;;
		esac
	done
	[ -n "$renderer" ] && export WLR_RENDERER=$renderer
fi
# X11 programs: Xwayland's glamor on OpenGL ES (Mesa has no desktop GL).
[ -x /usr/lib/xwayland/xwayland-gles ] && export WLR_XWAYLAND=/usr/lib/xwayland/xwayland-gles
# There is no accessibility bus (at-spi) yet.
export GTK_A11Y=none
# Without a hardware OpenGL driver, GTK draws with cairo too.
[ "${WLR_RENDERER:-}" = pixman ] && export GSK_RENDERER=cairo

# VMware's cursor plane stays invisible with wlroots: draw the cursor into
# the frame instead.
for driver in /sys/class/drm/card*/device/driver; do
	[ "$(basename "$(readlink "$driver")")" = vmwgfx ] &&
		export WLR_NO_HARDWARE_CURSORS=1
done

# run_labwc LOG [ARGS...]: run labwc with its output in LOG. If OpenGL ES
# fails right at the start (such as VMware with 3D acceleration off), it
# starts again with the software renderer (the first log is kept as
# LOG.gles). Returns labwc's exit status.
run_labwc() {
	log=$1
	shift
	started=$(date +%s)
	labwc "$@" > "$log" 2>&1
	status=$?
	if [ $status -ne 0 ] && [ "${WLR_RENDERER:-}" != pixman ] &&
	   [ $(($(date +%s) - started)) -lt 15 ]; then
		mv "$log" "$log.gles"
		export WLR_RENDERER=pixman GSK_RENDERER=cairo
		labwc "$@" > "$log" 2>&1
		status=$?
	fi
	return $status
}
