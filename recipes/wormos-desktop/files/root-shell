#!/bin/sh
# Root's side of the root terminal, run by elevate: the desktop's display and a
# runtime folder of root's own (nothing it writes lands in the user's),
# then root's login shell. A command given runs first, in FOLDER when
# given; the shell stays, unless ONCE is set (then the command's status
# is returned).
# Usage: root-shell WAYLAND_DISPLAY DISPLAY [COMMAND [FOLDER [BRIDGE [ONCE]]]]
mkdir -p -m 0700 /run/user/0
export XDG_RUNTIME_DIR=/run/user/0
[ -n "${1:-}" ] && export WAYLAND_DISPLAY="$1"
[ -n "${2:-}" ] && export DISPLAY="$2"
[ -n "${5:-}" ] && export WORMHOLE_BRIDGE="$5"
[ -n "${4:-}" ] && { cd "$4" 2>/dev/null || true; }
if [ -n "${6:-}" ]; then
	exec sh -c "$3"
fi
if [ -n "${3:-}" ]; then
	printf '\033[1m# %s\033[0m\n' "$3"
	sh -c "$3"
fi
exec "${SHELL:-/bin/sh}" -l
