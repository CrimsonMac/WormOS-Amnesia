name=wormos-desktop
version=1.0
release=24
description="The WormOS desktop session: labwc, foot and the WormOS look"
depends=(labwc foot swaybg grim wlr-randr xcompose seatd dbus font-inter font-hack base-files
	gtk4 gtk4-layer-shell wormos-gtk-theme adwaita-icon-theme dconf worm-shell wormos-snapshots
	pipewire wireplumber clip zsh xz bzip2 less libarchive nano licenses)
# The last line replaces busybox applets that the busybox package left out.
# Here rather than in busybox: wh plans an upgrade in name order, so an older
# wh upgrades busybox (dropping its links) before it installs these.

build() {
	python3 "$recipedir/files/wallpaper.py" wormos.png 2560 1440
}

package() {
	local f=$recipedir/files
	install -Dm755 "$f/session" "$pkgdir/usr/lib/worm/session"
	install -Dm644 "$f/session-env" "$pkgdir/usr/lib/worm/session-env"
	install -Dm755 "$f/screenshot" "$pkgdir/usr/lib/worm/screenshot"
	install -Dm755 "$f/apps-menu" "$pkgdir/usr/lib/worm/apps-menu"
	install -Dm644 "$f/desktop.sh" "$pkgdir/etc/profile.d/desktop.sh"
	install -Dm644 -t "$pkgdir/etc/xdg/labwc" "$f/labwc/rc.xml" "$f/labwc/menu.xml" \
		"$f/labwc/autostart" "$f/labwc/environment"
	install -Dm644 "$f/theme/themerc" "$pkgdir/usr/share/themes/WormOS/labwc/themerc"
	install -Dm644 "$f/foot.ini" "$pkgdir/etc/xdg/foot/foot.ini"
	install -Dm644 "$f/xkb/rules/evdev" "$pkgdir/etc/xkb/rules/evdev"
	install -Dm644 "$f/xkb/symbols/wormos" "$pkgdir/etc/xkb/symbols/wormos"
	install -Dm644 "$f/gtk-settings.ini" "$pkgdir/etc/gtk-4.0/settings.ini"
	install -Dm644 "$f/root-terminal.desktop" \
		"$pkgdir/usr/share/applications/org.wormos.RootTerminal.desktop"
	install -Dm755 "$f/welcome" "$pkgdir/usr/bin/welcome"
	install -Dm755 "$f/xdg-terminal-exec" "$pkgdir/usr/bin/xdg-terminal-exec"
	install -Dm644 "$f/motd.sh" "$pkgdir/etc/profile.d/motd.sh"
	install -Dm644 -t "$pkgdir/usr/share/wormos" "$f/guide" "$f/tips"
	install -Dm644 wormos.png "$pkgdir/usr/share/backgrounds/wormos.png"
}
