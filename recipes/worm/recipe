name=worm
version=0.1.0
release=21
description="WormOS system features (worm status, panic, fw, anon, kit, vm, unlock, lock, the power button, the guest agent)"
depends=(glibc snap nftables libxcrypt curl tzdata)
# Builds src/worm, which also uses sources from src/common.
localsrc=src

build() {
	make -C worm CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make -C worm DESTDIR="$pkgdir" install
	install -Dm644 "$recipedir/files/03-powerkey" "$pkgdir/etc/worm/services/03-powerkey"
	install -Dm644 -t "$pkgdir/usr/share/worm/kits" "$recipedir"/files/kits/*
	install -Dm644 "$recipedir/files/35-time" "$pkgdir/etc/worm/services/35-time"
	install -Dm755 "$recipedir/files/timesync" "$pkgdir/usr/lib/worm/timesync"
	install -Dm644 "$recipedir/files/13-vm" "$pkgdir/etc/worm/services/13-vm"
	install -Dm644 "$recipedir/files/45-guest-agent" "$pkgdir/etc/worm/services/45-guest-agent"
	install -Dm644 -t "$pkgdir/usr/share/worm/vm" "$recipedir"/files/vm/*
}
