name=wormos-installer
version=0.1.0
release=2
description="Installer: puts WormOS from the live ISO onto a disk"
depends=(glibc gtk4 worm zstd cryptsetup hicolor-icon-theme)
localsrc=src/installer

build() {
	make CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make DESTDIR="$pkgdir" install
}
