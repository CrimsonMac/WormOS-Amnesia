name=worm-shell
version=0.1.0
release=11
description="The WormOS desktop shell: panel, application launcher and notifications"
depends=(glibc json-c gtk4 gtk4-layer-shell wayland glib worm wormos-gtk-theme adwaita-icon-theme
	wireplumber)
# Builds src/shell, which also uses src/common.
localsrc=src

build() {
	make -C shell CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" \
		WAYLAND_SCANNER="$NATIVE/bin/wayland-scanner"
}

package() {
	make -C shell DESTDIR="$pkgdir" install
}
