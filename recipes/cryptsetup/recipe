name=cryptsetup
version=2.8.9
description="Disk encryption (LUKS2) for the installer and the initramfs"
depends=(glibc openssl json-c popt device-mapper e2fsprogs)
source=(https://mirrors.edge.kernel.org/pub/linux/utils/cryptsetup/v2.8/cryptsetup-$version.tar.xz)
sha256=(8667085a4f59174928948b501b4a2a68f7f1cce1cfe46170b8f40fa6534742b3)

build() {
	# OpenSSL for the ciphers, Argon2 built in; no blkid (e2fsprogs' older
	# libblkid lacks the probing interface), udev, SSH tokens or NLS.
	./configure --host="$TARGET" --prefix=/usr --sbindir=/usr/bin --disable-static \
		--with-crypto_backend=openssl --enable-internal-argon2 --disable-blkid \
		--disable-udev --disable-ssh-token --disable-external-tokens --disable-asciidoc \
		--disable-nls --disable-veritysetup --disable-integritysetup \
		--disable-pwquality --disable-passwdqc --with-tmpfilesdir=no
	make
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir"/usr/lib/*.la "$pkgdir/usr/share" "$pkgdir/usr/lib/tmpfiles.d"
}
