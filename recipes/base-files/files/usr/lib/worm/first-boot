#!/bin/sh
# First-boot setup: create the first user account and set the root
# password. Runs on the first console while no user account exists.
# --needed only tells (by its exit status) whether setup is needed.
# --create NAME FULL-NAME LAYOUT [ZONE] creates the account without asking
# (for the graphical setup): the user's and root's passwords are read from
# standard input, one per line; LAYOUT is a keyboard layout such as de,
# ZONE a time zone such as Europe/Berlin (UTC when left out).

needed() {
	! awk -F: '$3 >= 1000 && $3 < 65534 { found = 1 } END { exit !found }' /etc/passwd
}

valid_name() {
	case $1 in
	""|*[!a-z0-9_-]*|[!a-z_]*) return 1 ;;
	esac
	[ ${#1} -le 32 ] && ! grep -q "^$1:" /etc/passwd /etc/group
}

valid_zone() {
	case $1 in
	""|*..*|/*|*[!A-Za-z0-9/_+-]*) return 1 ;;
	esac
	[ -f "/usr/share/zoneinfo/$1" ]
}

# create_account NAME FULL-NAME LAYOUT USER-PASSWORD ROOT-PASSWORD [ZONE]
create_account() {
	worm unlock > /dev/null || return 1
	ok=1
	if [ -n "${6:-}" ] && [ "$6" != UTC ]; then
		ln -sfn "/usr/share/zoneinfo/$6" /etc/localtime || ok=
	fi
	shell=/bin/sh
	[ -x /usr/bin/zsh ] && shell=/usr/bin/zsh
	adduser -D -s "$shell" -g "${2:-$1}" "$1" || ok=
	# Private to its owner (adduser makes it readable for every user).
	[ -n "$ok" ] && { chmod 700 "/home/$1" || ok=; }
	if [ -n "$ok" ]; then
		for group in wheel video input audio render kvm; do
			addgroup "$1" "$group" || ok=
		done
		printf '%s:%s\nroot:%s\n' "$1" "$4" "$5" | chpasswd -c yescrypt || ok=
	fi
	worm lock -c "First boot: created $1" > /dev/null
	[ -n "$ok" ] || return 1
	/usr/lib/worm/runtime-dirs
	# The keyboard layout for the desktop.
	if [ -n "$3" ] && [ "$3" != us ]; then
		mkdir -p "/home/$1/.config/labwc" &&
		echo "XKB_DEFAULT_LAYOUT=$3" > "/home/$1/.config/labwc/environment" &&
		chown -R "$1:$1" "/home/$1/.config"
	fi
	return 0
}

if [ "$1" = --needed ]; then
	needed
	exit
fi
needed || exit 0

if [ "$1" = --create ]; then
	[ $# -eq 4 ] || [ $# -eq 5 ] ||
		{ echo "usage: first-boot --create NAME FULL-NAME LAYOUT [ZONE]" >&2; exit 2; }
	zone=${5:-UTC}
	valid_zone "$zone" || { echo "Unknown time zone." >&2; exit 2; }
	valid_name "$2" || { echo "That user name cannot be used." >&2; exit 2; }
	case $3$4 in
	*:*|*,*) echo "The full name cannot contain : or ," >&2; exit 2 ;;
	esac
	case $4 in
	*[!a-z]*) echo "Unknown keyboard layout." >&2; exit 2 ;;
	esac
	read -r user_password || exit 2
	read -r root_password || exit 2
	if [ -z "$user_password" ] || [ -z "$root_password" ]; then
		echo "The passwords cannot be empty." >&2
		exit 2
	fi
	create_account "$2" "$3" "$4" "$user_password" "$root_password" "$zone" || {
		echo "Setting up the account failed." >&2
		exit 1
	}
	exit 0
fi

trap 'stty echo 2>/dev/null' EXIT INT TERM

# ask_password PROMPT: read a password twice; the result is in $password.
ask_password() {
	while :; do
		stty -echo
		printf '%s: ' "$1"
		read -r password
		printf '\nRepeat it: '
		read -r again
		stty echo
		echo
		if [ -z "$password" ]; then
			echo "The password cannot be empty."
		elif [ "$password" != "$again" ]; then
			echo "The passwords do not match, try again."
		else
			return
		fi
	done
}

clear
cat <<'TEXT'

Welcome to WormOS.

Before the first login, create your account. Your user runs the desktop;
the root password is for administration (su, snapshots, packages).

TEXT

while :; do
	printf 'Username: '
	read -r name
	case $name in
	"")
		continue ;;
	*[!a-z0-9_-]*|[!a-z_]*)
		echo "Use lowercase letters, digits, '-' and '_', starting with a letter." ;;
	*)
		if [ ${#name} -gt 32 ]; then
			echo "At most 32 characters."
		elif ! valid_name "$name"; then
			echo "That name is already in use."
		else
			break
		fi ;;
	esac
done

ask_password "Password for $name"
user_password=$password
ask_password "Root password"
root_password=$password
password= again=

echo
echo "Creating the account..."
if ! create_account "$name" "$name" us "$user_password" "$root_password"; then
	user_password= root_password=
	echo "Setting up the account failed; it will be tried again." >&2
	sleep 5
	exit 1
fi
user_password= root_password=
echo "Done. Log in as $name to start the desktop."
echo
