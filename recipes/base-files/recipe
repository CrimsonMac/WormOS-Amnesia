name=base-files
version=1.17
release=1
description="Base system configuration and directory layout"

package() {
	cp -a "$recipedir/files/." "$pkgdir/"
	chmod 600 "$pkgdir/etc/shadow"

	# Generated at runtime on tmpfs, so /etc can stay read-only.
	ln -s ../run/resolv.conf "$pkgdir/etc/resolv.conf"
	ln -s ../proc/self/mounts "$pkgdir/etc/mtab"

	mkdir -p "$pkgdir/etc/profile.d"
	# Mount points: / is read-only, so they must exist in the image
	# (worm vm mounts the host's shared folders under /media).
	mkdir -p "$pkgdir/media" "$pkgdir/mnt"
	chmod 755 "$pkgdir/media" "$pkgdir/mnt"

	# The console greeting, with the version from os-release, so it never
	# goes stale: a small wormhole, its core bright.
	local version m b r
	version=$(sed -n 's/^PRETTY_NAME="\(.*\)"/\1/p' "$pkgdir/etc/os-release")
	m=$(printf '\033[35m') b=$(printf '\033[1;95m') r=$(printf '\033[0m')
	{
		printf '\n'
		printf "   %s.-'''-.%s\n" "$m" "$r"
		printf '  %s(  %s(@)%s  )%s   %s\n' "$m" "$b" "$m" "$r" "$version"
		printf "   %s'-...-'%s    %s\n" "$m" "$r" '\n on \l'
		printf '\n'
	} > "$pkgdir/etc/issue"
}
