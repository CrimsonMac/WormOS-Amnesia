name=harfbuzz
version=15.2.0
description="Text shaping engine"
depends=(glibc gcc-libs freetype glib)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://github.com/harfbuzz/harfbuzz/releases/download/$version/harfbuzz-$version.tar.xz)
sha256=(e2ec49090744383cdbe7df808c1cedaafba06a97be8dc4211fe546ba585f12cb)

build() {
	# GTK needs the subset library and the GLib integration.
	meson_build -Dfreetype=enabled -Dglib=enabled -Dgobject=disabled \
		-Dcairo=disabled -Dchafa=disabled -Dicu=disabled -Dpng=disabled \
		-Dzlib=disabled -Dgpu=disabled -Dgpu_demo=disabled -Dsubset=enabled \
		-Draster=disabled -Dvector=disabled \
		-Dtests=disabled -Dintrospection=disabled -Ddocs=disabled \
		-Dutilities=disabled -Dbenchmark=disabled
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/lib/cmake"
}
