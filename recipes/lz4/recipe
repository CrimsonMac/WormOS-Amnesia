name=lz4
version=1.11.1
description="LZ4: very fast compression"
depends=(glibc)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://github.com/lz4/lz4/releases/download/v$version/lz4-$version.tar.gz)
sha256=(683fed08a844ad012196381e40badf80c0bbe4962959761416d41c9e67d77ec7)

build() {
	make CC="$CC" AR="$AR" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" PREFIX=/usr \
		BUILD_STATIC=no -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr BUILD_STATIC=no install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/lib"/*.a
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/lz4/LICENSE"
}
