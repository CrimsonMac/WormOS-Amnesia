name=sqlmap
version=1.10.11
description="sqlmap: automatic SQL injection testing (for systems you may test)"
depends=(python)
# Upstream publishes no signature: checksum pinned from the tagged archive.
source=(sqlmap-$version.tar.gz::https://github.com/sqlmapproject/sqlmap/archive/refs/tags/$version.tar.gz)
sha256=(22a8dbd1b18b2249302029a3ed259a92adecc9103cc2fa4908aac0d3743e8ad0)

package() {
	mkdir -p "$pkgdir/usr/share/sqlmap"
	cp -a . "$pkgdir/usr/share/sqlmap/"
	rm -rf "$pkgdir/usr/share/sqlmap/.git"* "$pkgdir/usr/share/sqlmap/doc" \
		"$pkgdir/usr/share/sqlmap/.github"
	install -Dm755 /dev/stdin "$pkgdir/usr/bin/sqlmap" <<-'SH'
	#!/bin/sh
	exec python3 /usr/share/sqlmap/sqlmap.py "$@"
	SH
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/sqlmap/LICENSE"
}
