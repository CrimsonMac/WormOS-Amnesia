name=readline
version=8.3.6
description="GNU readline: line editing for interactive programs"
depends=(glibc ncurses)
# Signed by Chet Ramey (7C0135FB088AAF6C66C650B9BB5869F064EA74AB).
# The upstream patches up to the patch level in the version.
