	72dee13601ce38f6746eb15239999a7c56f8e1ff5eb1ec8153a1f213e4acdb29
	1f189c4566aa35950964647b9ec3be1a821e42b86048129c63eb7f9d4d2f5a74
	5481adbe161c9f6ba972c74db9e18c7aa351d3df3035cc4a673a1aa06247d1c6
	4ebd261a608287796e171af0ea9af5a1e3122e46672accda2484b6698c47c1a4)

build() {
	local i
	for i in $(seq 1 6); do
		patch -p0 < "$SOURCES/readline83-$(printf %03d "$i")"
	done
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-static --with-curses --disable-install-examples
	make -j"$JOBS" SHLIB_LIBS=-lncursesw
}

package() {
	make DESTDIR="$pkgdir" SHLIB_LIBS=-lncursesw install
	rm -rf "$pkgdir/usr/share" "$pkgdir/usr/bin"
}
