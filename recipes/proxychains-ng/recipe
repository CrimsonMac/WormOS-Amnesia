name=proxychains-ng
version=4.18
description="proxychains: send a program's connections through SOCKS proxies (Tor by default)"
depends=(glibc)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://github.com/rofl0r/proxychains-ng/releases/download/v$version/proxychains-ng-$version.tar.xz)
sha256=(97e9d08d382643c3703911708762504b0eb41f78cf382b1083754e326386051c)

build() {
	# Its own configure script: takes the compiler from the environment.
	CC="$CC" ./configure --prefix=/usr --sysconfdir=/etc --host="$TARGET"
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install install-config
	ln -s proxychains4 "$pkgdir/usr/bin/proxychains"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/proxychains-ng/COPYING"
}
