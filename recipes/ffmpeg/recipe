name=ffmpeg
version=9.1
description="FFmpeg: convert, cut and inspect audio and video (ffmpeg, ffprobe)"
depends=(glibc zlib bzip2 xz openssl alsa-lib)
# Upstream signs releases with its own key; checksum pinned from the release download.
source=(https://ffmpeg.org/releases/ffmpeg-$version.tar.xz)
sha256=(1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433)

build() {
	# LGPL build (no --enable-gpl): its own codecs, no external codec
	# libraries; ffmpeg -version prints this configuration, so no paths.
	./configure --prefix=/usr --enable-cross-compile --cross-prefix="$TARGET-" \
		--arch=x86_64 --target-os=linux --pkg-config=pkg-config \
		--enable-shared --disable-static --disable-doc --disable-debug --disable-stripping \
		--disable-ffplay --enable-openssl --enable-zlib --enable-bzlib --enable-lzma \
		--disable-xlib --disable-libxcb --disable-sdl2 --disable-vaapi --disable-vdpau \
		--disable-vulkan --disable-libdrm
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/ffmpeg/examples" "$pkgdir/usr/share/man"
	install -Dm644 COPYING.LGPLv2.1 "$pkgdir/usr/share/licenses/ffmpeg/COPYING.LGPLv2.1"
}
