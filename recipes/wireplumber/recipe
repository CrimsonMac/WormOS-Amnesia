name=wireplumber
version=0.5.19
description="PipeWire session manager: devices, default outputs, volumes"
depends=(glibc pipewire glib lua)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://gitlab.freedesktop.org/pipewire/wireplumber/-/archive/$version/wireplumber-$version.tar.gz)
sha256=(f9454eae3a5a6ca903c05ead2a7e47d7d3957fb0ffac3ebb11d92842603ae80f)

build() {
	meson_build -Dsystem-lua=true -Dintrospection=disabled -Ddoc=disabled \
		-Delogind=disabled -Dsystemd=disabled -Dsystemd-system-service=false \
		-Dsystemd-user-service=false -Dtests=false -Ddbus-tests=false
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/locale" "$pkgdir/usr/share/doc" \
		"$pkgdir/usr/share/zsh" "$pkgdir/usr/share/bash-completion"
	install -Dm644 "$recipedir/files/90-wormos.conf" \
		"$pkgdir/usr/share/wireplumber/wireplumber.conf.d/90-wormos.conf"
}
