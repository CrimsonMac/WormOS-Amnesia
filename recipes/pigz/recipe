name=pigz
version=2.8
description="pigz: gzip on every CPU core"
depends=(glibc zlib)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://zlib.net/pigz/pigz-$version.tar.gz)
sha256=(eb872b4f0e1f0ebe59c9f7bd8c506c4204893ba6a8492de31df416f0d5170fd0)

build() {
	make CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	install -Dm755 pigz "$pkgdir/usr/bin/pigz"
	ln -s pigz "$pkgdir/usr/bin/unpigz"
	sed -n '/^  Copyright/,/^  Mark Adler/p' pigz.c > LICENSE
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/pigz/LICENSE"
}
