# WormOS Amnesia: no microphone. Sound capture devices (pcmC*D*c) belong to
# root alone, so neither PipeWire nor any program the live user runs can
# record; playback is unaffected. There is no root to change this.
SUBSYSTEM=="sound", KERNEL=="pcmC[0-9]*D[0-9]*c", OWNER="root", GROUP="root", MODE="0600"
