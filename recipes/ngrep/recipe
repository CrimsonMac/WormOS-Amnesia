name=ngrep
version=1.49.0
description="ngrep: grep for network traffic"
depends=(glibc libpcap)
# Upstream publishes no signature: checksum pinned from the tagged archive.
source=(ngrep-$version.tar.gz::https://github.com/jpr5/ngrep/archive/refs/tags/v$version.tar.gz)
sha256=(6c94b31681316b7469a3ace92d2aeec7c9f490bd6782453dff2ade0e289a3348)

build() {
	[ -x configure ] || autoreconf -fi > /dev/null 2>&1
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--with-pcap-includes="$SYSROOT/usr/include" --disable-dropprivs
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	rm -f "$pkgdir"/usr/lib/*.la
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ngrep/LICENSE"
}
