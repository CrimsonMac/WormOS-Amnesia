name=libxshmfence
version=1.3.3
description="X shared memory fences (DRI3 synchronisation for Xwayland)"
depends=(glibc)
# Checksum pinned from the release download.
source=(https://www.x.org/releases/individual/lib/libxshmfence-$version.tar.xz)
sha256=(d4a4df096aba96fea02c029ee3a44e11a47eb7f7213c1a729be83e85ec3fde10)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc --localstatedir=/var --disable-static --with-shared-memory-dir=/dev/shm
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/doc"
}
