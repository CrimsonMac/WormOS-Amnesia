name=vim
version=9.2.1376
description="Vi IMproved, the text editor (also vi)"
depends=(glibc ncurses wayland pixman)
source=(vim-$version.tar.gz::https://github.com/vim/vim/archive/refs/tags/v$version.tar.gz)
sha256=(6525a5b23cd6bef6225f0e1da7b0a38fd02634951a9c0d54f852d1e8021fff35)

build() {
	# Answers for checks a cross build cannot run (glibc and ncurses).
	export vim_cv_toupper_broken=no vim_cv_terminfo=yes vim_cv_tgetent=zero \
		vim_cv_getcwd_broken=no vim_cv_stat_ignores_slash=no \
		vim_cv_memmove_handles_overlap=yes vim_cv_tty_group=world \
		vim_cv_tty_mode=0620 ac_cv_sizeof_int=4 ac_cv_small_wchar_t=no
	# src/configure reads srcdir from the environment, where wbuild sets it.
	cd src
	srcdir=. ./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--with-features=huge --disable-gui --without-x --enable-multibyte \
		--with-tlib=ncursesw --disable-nls --disable-netbeans --disable-canberra \
		--disable-libsodium --disable-selinux --disable-xsmp --disable-gpm \
		--disable-sysmouse --disable-perlinterp --disable-pythoninterp \
		--disable-python3interp --disable-rubyinterp --disable-luainterp \
		--disable-tclinterp --disable-hardcopy-pango --with-wayland \
		--with-compiledby=WormOS
	make -j"$JOBS"
	# vim --version shows the compile and link lines: without the sysroot.
	sed -i "s|-[IL]$SYSROOT[^ \"]*||g" auto/pathdef.c
	make -j"$JOBS"
}

package() {
	make -C src DESTDIR="$pkgdir" STRIP=true install
	ln -s vim "$pkgdir/usr/bin/vi"
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/applications" \
		"$pkgdir/usr/share/icons" "$pkgdir/usr/share/vim/vim92/lang"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vim/LICENSE"
}
