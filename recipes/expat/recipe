name=expat
version=2.10.0
description="XML parsing library"
depends=(glibc)
# Signed by Sebastian Pipping (3176EF7DB2367F1FCA4F306B1F9B0E909AF37285).
source=(https://github.com/libexpat/libexpat/releases/download/R_2_10_0/expat-$version.tar.xz)
sha256=(c624ba2998fc65df1163a49641ff3f9ab73138b11641d92c86bee0fb01b1bc7f)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--without-docbook --without-examples --without-tests --disable-static
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
	rm -rf "$pkgdir/usr/bin" "$pkgdir/usr/share"
}
