name=snap
version=0.1.0
release=4
description="WormOS snapshot tool"
depends=(glibc)
localsrc=src/snap

build() {
	make CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 "$recipedir/files/11-snap-status" "$pkgdir/etc/worm/services/11-snap-status"
}
