name=busybox
version=1.38.0
release=7
description="Core command-line utilities (temporary userland)"
depends=(glibc)
source=(https://busybox.net/downloads/busybox-$version.tar.bz2)
sha256=(34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2)

bb_set() {
	sed -i "/^CONFIG_$1=/d; /^# CONFIG_$1 is not set/d" .config
	echo "CONFIG_$1=$2" >> .config
}

bb_unset() {
	sed -i "/^CONFIG_$1=/d; /^# CONFIG_$1 is not set/d" .config
	echo "# CONFIG_$1 is not set" >> .config
}

build() {
	# su and login wait for each other per account (see the patch).
	patch -p1 < "$recipedir/files/auth-lock.patch"
	make defconfig
	bb_unset INIT            # worminit is PID 1
	bb_unset LINUXRC
	bb_unset TC              # does not build against current kernel headers
	bb_unset FEATURE_SUID    # no setuid multi-call binary
	local applet             # kmod and eudev handle modules and devices
	for applet in INSMOD RMMOD LSMOD MODPROBE DEPMOD MODINFO MDEV; do
		bb_unset $applet
	done
	bb_set EXTRA_CFLAGS "\"-std=gnu17\""
	# passwd and chpasswd hash with yescrypt, as WormOS's own tools do: the
	# default (DES) keeps eight characters, and libxcrypt (strong hashes
	# only) cannot check it.
	bb_set FEATURE_DEFAULT_PASSWD_ALGO "\"yescrypt\""
	make oldconfig < /dev/null > /dev/null

	make CROSS_COMPILE="$TARGET-" CONFIG_EXTRA_LDFLAGS="$LDFLAGS" -j"$JOBS"
	make CROSS_COMPILE="$TARGET-" busybox.links

	# su must be setuid root. Rather than making the whole multi-call
	# binary setuid, a second build holds su alone.
	rm -rf ../busybox-su
	cp -a . ../busybox-su
	cd ../busybox-su
	make clean > /dev/null
	make allnoconfig > /dev/null
	bb_set SU y
	bb_set FEATURE_SU_SYSLOG y
	bb_set FEATURE_SU_CHECKS_SHELLS y
	bb_set FEATURE_SHADOWPASSWDS y
	bb_set USE_BB_CRYPT y
	bb_set USE_BB_CRYPT_SHA y
	# passwd and chpasswd write yescrypt: su must read it.
	bb_set USE_BB_CRYPT_YES y
	bb_set FEATURE_SUID y
	bb_set LONG_OPTS y
	bb_set EXTRA_CFLAGS "\"-std=gnu17\""
	make oldconfig < /dev/null > /dev/null
	make CROSS_COMPILE="$TARGET-" CONFIG_EXTRA_LDFLAGS="$LDFLAGS" -j"$JOBS"
}

REPLACED="xz unxz xzcat lzma unlzma lzcat bzip2 bunzip2 bzcat less tree lsof tar cpio
	unzip vi xxd strings"
REPLACED=$(echo $REPLACED)

package() {
	install -Dm755 busybox "$pkgdir/usr/bin/busybox"
	install -Dm4755 ../busybox-su/busybox "$pkgdir/usr/bin/su"
	install -Dm755 examples/udhcp/simple.script \
		"$pkgdir/usr/share/udhcpc/default.script"

	# Merged /usr: every applet goes into /usr/bin or /usr/sbin.
	mkdir -p "$pkgdir/usr/sbin"
	local path applet
	while read -r path; do
		applet=${path##*/}
		case $applet in busybox|su) continue ;; esac
		# Applets whose full versions are packages of their own (xz, bzip2,
		# less, tree, lsof, libarchive's tar/cpio/unzip, vim's vi and xxd,
		# binutils' strings).
		case " $REPLACED " in *" $applet "*) continue ;; esac
		case $path in
			*sbin/*) ln -sf ../bin/busybox "$pkgdir/usr/sbin/$applet" ;;
			*)       ln -sf busybox "$pkgdir/usr/bin/$applet" ;;
		esac
	done < busybox.links

	# The links shipped, for wh: when a package that took one over (GNU
	# grep, coreutils...) is removed, wh points it at busybox again.
	(cd "$pkgdir" && find usr/bin usr/sbin -type l -lname '*busybox' | sort) \
		> ../busybox-links
	install -Dm644 ../busybox-links "$pkgdir/usr/share/busybox/links"
}
