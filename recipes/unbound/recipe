name=unbound
version=1.26.2
description="Validating, caching DNS resolver (encrypted upstream queries)"
depends=(glibc openssl expat ca-certificates)
users=(unbound)
# Signed by NLnet Labs (231018690C4D903EF419146AA144323DEAACDF45).
source=(https://nlnetlabs.nl/downloads/unbound/unbound-$version.tar.gz)
sha256=(d8ee7aa6bbb3ff1be7d9e57637d0d0ec2f18273a8efff1a0afe2c665858b96f7)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc --with-ssl="$SYSROOT/usr" --with-libexpat="$SYSROOT/usr" \
		--with-conf-file=/etc/unbound/unbound.conf --with-run-dir=/var/lib/unbound \
		--with-rootkey-file=/var/lib/unbound/root.key --with-chroot-dir= \
		--with-pidfile= --with-username=unbound --disable-static \
		--without-pythonmodule --without-pyunbound --disable-flto
	# --with-ssl and --with-libexpat add a run path into the sysroot and
	# end up in the configure line 'unbound -V' prints.
	sed -i 's|^RUNTIME_PATH=.*|RUNTIME_PATH=|' Makefile
	sed -i "s|$SYSROOT||g" config.h
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la "$pkgdir/usr/sbin/unbound-control-setup"
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/etc/unbound"
	install -Dm644 "$recipedir/files/unbound.conf" "$pkgdir/etc/unbound/unbound.conf"
	mkdir -p "$pkgdir/etc/unbound/unbound.conf.d"
	# The DNSSEC root trust anchors (KSK-2017 and KSK-2024, from IANA's
	# root-anchors.xml); unbound keeps its own copy up to date (RFC 5011).
	install -Dm644 "$recipedir/files/root.key" "$pkgdir/usr/share/unbound/root.key"
	install -Dm644 "$recipedir/files/15-dns" "$pkgdir/etc/worm/services/15-dns"
}
