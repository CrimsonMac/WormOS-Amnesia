name=linux-firmware-wireless
version=20261019
release=2
description="Firmware for Intel, MediaTek and Realtek Wi-Fi and Bluetooth, and Realtek Ethernet, from linux-firmware"
depends=()
# Signed by Josh Boyer (4CDE8575E547BF835FE15807A31B6BD72486CFD6).
source=(https://www.kernel.org/pub/linux/kernel/firmware/linux-firmware-$version.tar.xz)
sha256=(a10d1ab5baf2c74ba92e8c7cf313e691696c26bddfa6df00db795e48d70cd4ca)
noextract=1

build() {
	rm -rf "$srcdir"/*
	tar -xf "$SOURCES/linux-firmware-$version.tar.xz" --strip-components=1 \
		--wildcards "*/intel/iwlwifi/*" "*/intel/ibt-*" \
		"*/mediatek/WIFI_*" "*/mediatek/BT_RAM_CODE_*" "*/mediatek/mt7925/*" \
		"*/rtw88/*" "*/rtw89/*" "*/rtl_bt/*" "*/rtl_nic/*" \
		"*/LICENSES/LICENCE.iwlwifi_firmware" "*/LICENSES/LICENCE.ibt_firmware" \
		"*/LICENSES/LICENCE.mediatek" "*/LICENSES/LICENCE.rtlwifi_firmware.txt" \
		"*/WHENCE"
}

package() {
	local fw=$pkgdir/usr/lib/firmware f prefix
	local -A best
	mkdir -p "$fw/intel"
	# Each Wi-Fi chip's firmware comes in several API versions
	# (iwlwifi-NAME-77.ucode, -79...); the driver takes the newest it knows,
	# so only the newest is shipped. The kernel looks for them at the top
	# of the firmware folder (upstream's install links them there).
	for f in $(find intel/iwlwifi -name 'iwlwifi-*.ucode' | sort -V); do
		prefix=${f%-*}
		best[$prefix]=$f
	done
	[ ${#best[@]} -gt 0 ] || die "no Wi-Fi firmware found in the archive"
	for f in "${best[@]}"; do
		cp -L "$f" "$fw/"
	done
	find intel/iwlwifi -name 'iwlwifi-*.pnvm' -exec cp -L {} "$fw/" \;
	find intel -maxdepth 1 -name 'ibt-*' -exec cp -L {} "$fw/intel/" \;
	# MediaTek and Realtek: their folders as they are.
	cp -rL mediatek rtw88 rtw89 rtl_bt rtl_nic "$fw/"
	find "$fw" -type f -exec zstd -q -19 --rm {} +
	find "$fw" -type f -exec chmod 644 {} +
	install -Dm644 -t "$pkgdir/usr/share/licenses/linux-firmware-wireless" \
		LICENSES/LICENCE.iwlwifi_firmware LICENSES/LICENCE.ibt_firmware \
		LICENSES/LICENCE.mediatek LICENSES/LICENCE.rtlwifi_firmware.txt WHENCE
}
