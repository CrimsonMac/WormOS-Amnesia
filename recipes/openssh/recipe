name=openssh
version=10.6p2
release=2
description="SSH client: ssh, scp, sftp, ssh-keygen, ssh-agent"
depends=(glibc openssl zlib)
# Signed by Damien Miller (7168B983815A5EEF59A4ADFD2A3F414E736060BA).
source=(https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-$version.tar.gz)
sha256=(9ae44872090cf2f06b3cf9ff147e7f16f309671340763ed2f99248398ae29d5b)

# Only the client side. The server (sshd) needs host keys, a service and an
# open port, none of which WormOS sets up yet.
build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc/ssh --libexecdir=/usr/lib/ssh \
		--with-privsep-path=/var/empty --with-privsep-user=nobody \
		--disable-strip --without-pam --without-selinux --without-kerberos5 \
		--without-security-key-builtin --with-pid-dir=/run \
		--with-default-path=/usr/local/bin:/usr/bin
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install-nokeys
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/sbin" "$pkgdir/var"
	rm -f "$pkgdir"/usr/lib/ssh/{sshd-session,sshd-auth,sftp-server}
	# ssh-keysign is setuid root, only for host-based logins, which WormOS
	# never sets up: one setuid program fewer.
	rm -f "$pkgdir/usr/lib/ssh/ssh-keysign"
	rm -f "$pkgdir"/etc/ssh/{sshd_config,moduli}
	rm -rf "$pkgdir/etc/ssh/sshd_config.d"
	install -Dm644 LICENCE "$pkgdir/usr/share/licenses/openssh/LICENCE"
}
