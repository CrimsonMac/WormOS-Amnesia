name=wlroots
version=0.20.2
release=5
description="Modular Wayland compositor library"
depends=(glibc wayland libxkbcommon libdrm pixman mesa eudev libinput seatd libdisplay-info
	libxcb xcb-util-wm xwayland)
# Signed by Simon Ser (34FF9526CFEF0E97A340E2E40FDE7BE0E88F5E48).
source=(https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/$version/downloads/wlroots-$version.tar.gz)
sha256=(80c567d2ed4efb2cfa6b077f22c7a710d9c78ba4e185a75e8694001114af0733)

build() {
	# Follow the virtual machine's window size (see the patch).
	patch -p1 < "$recipedir/files/follow-preferred-mode.patch"
	# OpenGL clients on VMware's vmwgfx (see the patch).
	patch -p1 < "$recipedir/files/vmwgfx-dmabuf-check.patch"
	# The pixman (software) renderer is always built: it is the fallback
	# without a usable GPU.
	# X11 programs run in Xwayland, started when the first one connects.
	meson_build -Dxwayland=enabled -Dexamples=false -Drenderers=gles2 \
		-Dbackends=drm,libinput -Dallocators=gbm -Dsession=enabled \
		-Dcolor-management=disabled -Dlibliftoff=disabled -Dxcb-errors=disabled
	# Xwayland's path comes from its pkg-config file with the sysroot in
	# front: keep it /usr/bin/Xwayland.
	sed -i "s|$SYSROOT||g" build/include/config.h
	ninja -C build -j"$JOBS"
}

package() {
	meson_package
}
