name=wh
version=0.1.0
release=12
description="WormOS package manager"
depends=(glibc zstd curl snap gnupg wormhole-keyrings)
# Builds src/wh, which also uses sources from src/snap.
localsrc=src

build() {
	make -C wh CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make -C wh DESTDIR="$pkgdir" install
	install -Dm644 "$WORMOS_ROOT/keys/core.pub" "$pkgdir/usr/share/wh/keys/core.pub"
	install -Dm644 /dev/stdin "$pkgdir/etc/wh/repo" <<-END
	# The WormOS core package repository.
	https://github.com/CrimsonMac/wormos-packages/releases/download/core/
	END
	install -Dm644 /dev/stdin "$pkgdir/etc/wh/sources" <<-END
	# Distributions wh installs from when a package is not in the core
	# repository, tried in this order. Each gets its own container (a
	# wormhole). Stability first: Debian stable, then rolling Kali for what
	# Debian does not have. Mirrors use plain HTTP like apt: everything is
	# checked against the distribution's signatures.

	[debian]
	keyring = /usr/share/wh/keyrings/debian.pgp
	mirror = http://deb.debian.org/debian
	suite = trixie
	apt = deb http://deb.debian.org/debian trixie main
	apt = deb http://deb.debian.org/debian trixie-updates main
	apt = deb http://deb.debian.org/debian-security trixie-security main

	[kali]
	keyring = /usr/share/wh/keyrings/kali.pgp
	mirror = http://http.kali.org/kali
	suite = kali-rolling
	apt = deb http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware
	END
}
