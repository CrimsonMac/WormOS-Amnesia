name=grim
version=1.5.0
description="Screenshot tool for Wayland"
depends=(glibc wayland pixman libpng)
# Upstream publishes no signature: checksum pinned from the release download.
source=(https://gitlab.freedesktop.org/emersion/grim/-/archive/v$version/grim-v$version.tar.gz)
sha256=(9e72a98f7621b1f5741b405b8dbd447acf7d300ddb12667ec526db1ce6154eaa)

build() {
	meson_build -Djpeg=disabled -Dman-pages=disabled -Dfish-completions=false \
		-Dbash-completions=false
}

package() {
	meson_package
}
