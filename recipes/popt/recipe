name=popt
version=1.19
description="Command line option parsing library (for cryptsetup)"
depends=(glibc)
source=(https://ftp.osuosl.org/pub/rpm/popt/releases/popt-1.x/popt-$version.tar.gz)
sha256=(c25a4838fc8e4c1c8aacb8bd620edb3084a3d63bf8987fdad3ca2758c63240f9)

build() {
	./configure --host="$TARGET" --prefix=/usr --disable-static --disable-nls
	make
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir"/usr/lib/*.la "$pkgdir/usr/share"
}
