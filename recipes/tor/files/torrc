# WormOS: the Tor client behind 'worm anon'. In anonymous mode the
# firewall sends all TCP connections of the machine to TransPort and all
# DNS queries to DNSPort; only Tor itself (user tor) may reach the network.
# Programs can also use SocksPort directly.

User tor
DataDirectory /var/lib/tor
PidFile /run/tor/tor.pid
RunAsDaemon 1
Log notice file /run/tor/notices.log
AvoidDiskWrites 1

SocksPort 127.0.0.1:9050
# Every destination address gets its own circuit, so connections of
# different programs (or to different sites) cannot be linked by an exit
# relay. Tor Browser isolates its own sites through SOCKS on 9050.
TransPort 127.0.0.1:9040 IsolateDestAddr
DNSPort 127.0.0.1:5353
DNSPort [::1]:5353

# .onion names resolve to addresses in this range, which TransPort
# connects to through Tor.
AutomapHostsOnResolve 1
VirtualAddrNetworkIPv4 10.192.0.0/10

# 'worm anon new-circuits' asks Tor for fresh circuits through this socket.
# Only root reaches it: the directory is Tor's own (0700) and the cookie is
# readable by Tor alone. A program that could talk to Tor's controller
# could ask it for the machine's real address.
ControlSocket /run/tor-control/control
CookieAuthentication 1
CookieAuthFile /run/tor-control/cookie

# Bridges ('worm anon bridges') and other additions.
%include /etc/tor/torrc.d/
