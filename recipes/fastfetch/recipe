name=fastfetch
version=2.71.0
description="fastfetch: system information with the WormOS logo"
depends=(glibc)
# Upstream publishes no signature: checksum pinned from the tagged archive.
source=(fastfetch-$version.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz)
sha256=(e71d93de41e8e4b2554c36d2ae51758112a21ecf3a8c98605a2c689251e62987)

build() {
	# Optional libraries are opened at run time when present; none are
	# needed to build.
	cmake -S . -B build -G Ninja -DCMAKE_SYSTEM_NAME=Linux \
		-DCMAKE_SYSTEM_PROCESSOR=x86_64 -DCMAKE_C_COMPILER="$CC" \
		-DCMAKE_FIND_ROOT_PATH="$SYSROOT" -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
		-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
		-DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DBUILD_TESTS=OFF -DBUILD_FLASHFETCH=OFF -DENABLE_SYSTEM_YYJSON=OFF \
		-DENABLE_VULKAN=OFF -DENABLE_OPENCL=OFF -DENABLE_IMAGEMAGICK7=OFF \
		-DENABLE_IMAGEMAGICK6=OFF -DENABLE_CHAFA=OFF -DENABLE_RPM=OFF -DENABLE_DDCUTIL=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/bash-completion" \
		"$pkgdir/usr/share/fish" "$pkgdir/usr/share/zsh" "$pkgdir/usr/share/licenses"
	# The WormOS logo and layout for every user (fastfetch reads
	# /etc/xdg/fastfetch/config.jsonc).
	install -Dm644 "$recipedir/files/config.jsonc" "$pkgdir/etc/xdg/fastfetch/config.jsonc"
	install -Dm644 "$recipedir/files/logo.txt" "$pkgdir/usr/share/wormos/fastfetch-logo.txt"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/fastfetch/LICENSE"
}
