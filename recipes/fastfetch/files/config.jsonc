// WormOS defaults for fastfetch. Copy to ~/.config/fastfetch/config.jsonc
// to change them.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/wormos/fastfetch-logo.txt",
        "color": {
            "1": "38;2;91;33;182",
            "2": "38;2;124;58;237",
            "3": "38;2;167;139;250",
            "4": "38;2;216;180;254",
            "5": "1;38;2;253;244;255"
        },
        "padding": { "top": 1 }
    },
    "display": {
        "color": { "keys": "magenta", "title": "magenta" }
    },
    "modules": [
        "title", "separator", "os", "kernel", "uptime", "packages", "shell",
        "display", "wm", "terminal", "cpu", "gpu", "memory", "disk",
        "localip", "break", "colors"
    ]
}
