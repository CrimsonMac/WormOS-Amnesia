name=torsocks
version=2.5.0
description="torsocks: run one program through Tor (SOCKS on 127.0.0.1:9050)"
depends=(glibc tor)
# Upstream publishes no signature: checksum pinned from the tagged archive.
source=(torsocks-$version.tar.gz::https://gitlab.torproject.org/tpo/core/torsocks/-/archive/v$version/torsocks-v$version.tar.gz)
sha256=(0fc8e18f2dc2e12f1129054f6d5acc7ecc3f0345bb57ed653fc8c6674e6ecc7e)

build() {
	./autogen.sh > /dev/null 2>&1
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	rm -f "$pkgdir"/usr/lib/*.la
	rm -rf "$pkgdir/usr/share/torsocks"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/torsocks/LICENSE"
}
