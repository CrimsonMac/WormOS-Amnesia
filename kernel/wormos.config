# WormOS kernel configuration fragment.
# Applied on top of x86_64_defconfig by scripts/build-kernel.sh.

CONFIG_LOCALVERSION="-wormos"
CONFIG_DEFAULT_HOSTNAME="wormos"

# Boot without an initramfs: root filesystem and disk drivers are built in.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y

# Virtual hardware (QEMU / KVM)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y

# Consoles
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Isolation primitives used by wormholes and blackholes
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
# CPU weights for blackholes (cpu controller)
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_VETH=y
CONFIG_TUN=y

# Security modules. AppArmor is built but stays off unless named with lsm=
# on the command line. SELinux is not used.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_APPARMOR=y
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="lockdown,yama,integrity,landlock"

# Modules must carry the signature of the kernel build that made them. The
# key is generated in build/kernel/certs and never packaged.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# CONFIG_MODULE_FORCE_UNLOAD is not set
CONFIG_EFIVAR_FS=y

# Firewall: nftables only, built in so the rules load before any module
# could. No iptables or xtables, no conntrack helpers.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_SOCKET=y
CONFIG_NF_LOG_SYSLOG=y
# CONFIG_NF_CONNTRACK_FTP is not set
# CONFIG_NF_CONNTRACK_IRC is not set
# CONFIG_NF_CONNTRACK_SIP is not set
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_NETFILTER_XTABLES is not set
# No 6in4 tunnel device in every network namespace.
# CONFIG_IPV6_SIT is not set
CONFIG_WIREGUARD=y

# Host side of microVM blackholes, and the guest side so the same kernel
# can boot inside one.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
# The guest of bh open --vm boots from the blackhole's files over 9p
# (kvmtool's virtio-9p); built in, since it is the guest's root.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# Memory and code hardening
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_KSTACK_ERASE=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y

# Fewer ways to read or change the running kernel
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_USERFAULTFD is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0

# The BPF syscall stays disabled entirely.
# CONFIG_BPF_SYSCALL is not set

# Faster builds; debug info is not shipped.
CONFIG_DEBUG_INFO_NONE=y

# Graphics and input (phase 4). Intel GPUs load as signed modules so their
# firmware can come from the root filesystem; udev loads them on demand.
# Virtual GPUs: virtio-gpu and bochs (QEMU, built in above), vmwgfx
# (VMware, VirtualBox VMSVGA) and qxl (older QEMU/virt-manager setups).
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_QXL=m
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_EVDEV=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# VMware guests: paravirtual network and SCSI, LSI Logic SCSI, NVMe disks,
# VMCI sockets and the memory balloon.
CONFIG_BLK_DEV_NVME=y
CONFIG_VMXNET3=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_FUSION_SAS=y
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_VMCI_VSOCKETS=m
CONFIG_VMWARE_BALLOON=m

# Hyper-V guests (Windows' own VMs): disks, network, keyboard and mouse, the
# display, shutdown and time from the host, VM sockets and the balloon.
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_DRM_HYPERV=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=m
CONFIG_HYPERV_VSOCKETS=m

# VirtualBox guests: the guest device (mouse integration, host time), its
# shared folders (mount -t vboxsf, worm vm) and the old VBoxVGA display.
# VMSVGA, VirtualBox's default display, is vmwgfx above.
CONFIG_VBOXGUEST=m
CONFIG_VBOXSF_FS=m
CONFIG_DRM_VBOXVIDEO=m

# Sound (phase 5). The HD Audio controller driver is a module, loaded by
# udev: only then does it load codec drivers on its own (the code doing it
# is compiled only into a modular HD Audio core). Codec drivers load as
# modules when a codec is found: the generic one (QEMU's
# hda-duplex, VMware's HD Audio), Realtek, Conexant, Analog Devices,
# SigmaTel/IDT and Cirrus Logic on real machines, and HDMI/DisplayPort
# audio through Intel graphics. Also USB audio, virtio-sound and the
# Ensoniq AudioPCI that VMware offers for older guests.
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_VIRTIO=m
CONFIG_SND_ENS1371=m
