#!/usr/bin/env python3
"""qemu-clipboard - share the clipboard with WormOS in QEMU's own window.

QEMU's GTK window shares the clipboard through its built-in agent
(-chardev qemu-vdagent), but on a Wayland desktop a window may only set or
read the clipboard in narrow cases, and text does not get through. This
helper takes the place of QEMU's agent: QEMU connects the guest's agent
port to a socket, and the helper speaks the SPICE agent protocol on it,
moving text between the guest and the desktop's clipboard through KDE's
Klipper (D-Bus) or, elsewhere, wl-copy and wl-paste.

Start QEMU with
    -device virtio-serial-pci
    -chardev socket,id=vdagent0,path=SOCKET,server=on,wait=off
    -device virtserialport,chardev=vdagent0,name=com.redhat.spice.0
and then run: qemu-clipboard SOCKET   (it ends when QEMU does).
"""

import os
import shutil
import socket
import struct
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

VDP_CLIENT_PORT = 1
PROTOCOL = 1
CHUNK_MAX = 2048

MSG_CLIPBOARD = 4
MSG_ANNOUNCE_CAPABILITIES = 6
MSG_CLIPBOARD_GRAB = 7
MSG_CLIPBOARD_REQUEST = 8
MSG_CLIPBOARD_RELEASE = 9

CAP_CLIPBOARD_BY_DEMAND = 5
CAP_CLIPBOARD_SELECTION = 6
TYPE_NONE = 0
TYPE_UTF8_TEXT = 1
OUR_CAPS = (1 << CAP_CLIPBOARD_BY_DEMAND) | (1 << CAP_CLIPBOARD_SELECTION)


class Desktop:
    """The desktop's clipboard: Klipper over D-Bus, or wl-clipboard."""

    def __init__(self, on_change):
        self.on_change = on_change
        self.klipper = None
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
            proxy = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None,
                                           "org.kde.klipper", "/klipper",
                                           "org.kde.klipper.klipper")
            if proxy.get_name_owner():
                self.klipper = proxy
                proxy.connect("g-signal", self._signal)
        except GLib.Error:
            pass
        self.last = self.get()
        if not self.klipper:
            if not shutil.which("wl-paste"):
                sys.exit("qemu-clipboard: needs KDE's Klipper or wl-clipboard")
            GLib.timeout_add(700, self._poll)

    def _signal(self, proxy, sender, name, params):
        if name == "clipboardHistoryUpdated":
            self._check()

    def _poll(self):
        self._check()
        return True

    def _check(self):
        text = self.get()
        if text and text != self.last:
            self.last = text
            self.on_change(text)

    def get(self):
        if self.klipper:
            try:
                return self.klipper.call_sync("getClipboardContents", None,
                                              Gio.DBusCallFlags.NONE, 2000, None)[0]
            except GLib.Error:
                return ""
        out = subprocess.run(["wl-paste", "--no-newline", "--type", "text"],
                             capture_output=True)
        return out.stdout.decode("utf-8", "replace") if out.returncode == 0 else ""

    def set(self, text):
        self.last = text
        if self.klipper:
            self.klipper.call_sync("setClipboardContents", GLib.Variant("(s)", (text,)),
                                   Gio.DBusCallFlags.NONE, 2000, None)
        else:
            subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"],
                           input=text.encode())


class Agent:
    """The host's end of the SPICE agent protocol, on QEMU's socket."""

    def __init__(self, sock):
        self.sock = sock
        self.buf = b""
        self.msg = b""
        self.msg_size = None
        self.guest_caps = 0
        self.host_text = None       # desktop text the guest may ask for
        self.desktop = Desktop(self.desktop_changed)
        self.send(MSG_ANNOUNCE_CAPABILITIES, struct.pack("<II", 1, OUR_CAPS), sel=False)
        GLib.io_add_watch(sock.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.readable)

    def selection(self):
        return (self.guest_caps & (1 << CAP_CLIPBOARD_SELECTION)) != 0

    def send(self, msg_type, data, sel=True):
        head = b"\0\0\0\0" if sel and self.selection() else b""
        body = head + data
        message = struct.pack("<IIQI", PROTOCOL, msg_type, 0, len(body)) + body
        for i in range(0, len(message), CHUNK_MAX):
            part = message[i:i + CHUNK_MAX]
            self.sock.sendall(struct.pack("<II", VDP_CLIENT_PORT, len(part)) + part)

    def readable(self, fd, cond):
        try:
            data = self.sock.recv(65536)
        except OSError:
            data = b""
        if not data:
            loop.quit()
            return False
        self.buf += data
        while len(self.buf) >= 8:
            port, size = struct.unpack("<II", self.buf[:8])
            if len(self.buf) < 8 + size:
                break
            self.chunk(self.buf[8:8 + size])
            self.buf = self.buf[8 + size:]
        return True

    def chunk(self, data):
        self.msg += data
        while len(self.msg) >= 20:
            _, msg_type, _, size = struct.unpack("<IIQI", self.msg[:20])
            if len(self.msg) < 20 + size:
                return
            self.handle(msg_type, self.msg[20:20 + size])
            self.msg = self.msg[20 + size:]

    def handle(self, msg_type, data):
        if msg_type == MSG_ANNOUNCE_CAPABILITIES and len(data) >= 8:
            request, self.guest_caps = struct.unpack("<II", data[:8])
            if request:
                self.send(MSG_ANNOUNCE_CAPABILITIES, struct.pack("<II", 0, OUR_CAPS),
                          sel=False)
            return
        if msg_type not in (MSG_CLIPBOARD, MSG_CLIPBOARD_GRAB, MSG_CLIPBOARD_REQUEST,
                            MSG_CLIPBOARD_RELEASE):
            return
        if self.selection():
            if len(data) < 4 or data[0] != 0:   # only the clipboard selection
                return
            data = data[4:]
        if msg_type == MSG_CLIPBOARD_GRAB:
            types = struct.unpack(f"<{len(data) // 4}I", data[:len(data) // 4 * 4])
            if TYPE_UTF8_TEXT in types:
                self.host_text = None
                self.send(MSG_CLIPBOARD_REQUEST, struct.pack("<I", TYPE_UTF8_TEXT))
        elif msg_type == MSG_CLIPBOARD and len(data) >= 4:
            if struct.unpack("<I", data[:4])[0] == TYPE_UTF8_TEXT:
                self.desktop.set(data[4:].decode("utf-8", "replace"))
        elif msg_type == MSG_CLIPBOARD_REQUEST:
            if self.host_text is not None:
                self.send(MSG_CLIPBOARD, struct.pack("<I", TYPE_UTF8_TEXT) +
                          self.host_text.encode())
            else:
                self.send(MSG_CLIPBOARD, struct.pack("<I", TYPE_NONE))

    def desktop_changed(self, text):
        self.host_text = text
        self.send(MSG_CLIPBOARD_GRAB, struct.pack("<I", TYPE_UTF8_TEXT))


def connect(path):
    """QEMU's socket, once QEMU has made it (up to a minute)."""
    for _ in range(600):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(path)
            return s
        except OSError:
            s.close()
            time.sleep(0.1)
    sys.exit(f"qemu-clipboard: no socket at {path}")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: qemu-clipboard SOCKET")
    loop = GLib.MainLoop()
    agent = Agent(connect(sys.argv[1]))
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    os._exit(0)
